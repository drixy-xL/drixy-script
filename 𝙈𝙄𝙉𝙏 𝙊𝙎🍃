-- [[ MINT OS 🍃 - FLY GUI RED WHITE EDITION ]] --
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local FlyBtn = Instance.new("TextButton")
local SpeedUp = Instance.new("TextButton")
local SpeedDown = Instance.new("TextButton")
local SpeedLabel = Instance.new("TextLabel")
local CloseBtn = Instance.new("TextButton")
local MinBtn = Instance.new("TextButton")

-- Setup UI Utama
ScreenGui.Parent = game.CoreGui
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- Putih
MainFrame.Position = UDim2.new(0.5, -75, 0.5, -100)
MainFrame.Size = UDim2.new(0, 150, 0, 200)
MainFrame.Active = true
MainFrame.Draggable = true

-- Header Merah
Title.Parent = MainFrame
Title.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Merah
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "MINT OS 🍃"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextScaled = true

-- Variabel Fly
local flying = false
local speed = 50
local lp = game.Players.LocalPlayer

-- Tombol Fly
FlyBtn.Parent = MainFrame
FlyBtn.Position = UDim2.new(0.1, 0, 0.2, 0)
FlyBtn.Size = UDim2.new(0.8, 0, 0.2, 0)
FlyBtn.Text = "Fly: OFF"
FlyBtn.BackgroundColor3 = Color3.fromRGB(200, 200, 200)

-- Tombol Speed
SpeedUp.Parent = MainFrame
SpeedUp.Position = UDim2.new(0.1, 0, 0.45, 0)
SpeedUp.Size = UDim2.new(0.35, 0, 0.15, 0)
SpeedUp.Text = "+"
SpeedUp.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
SpeedUp.TextColor3 = Color3.fromRGB(255, 255, 255)

SpeedDown.Parent = MainFrame
SpeedDown.Position = UDim2.new(0.55, 0, 0.45, 0)
SpeedDown.Size = UDim2.new(0.35, 0, 0.15, 0)
SpeedDown.Text = "-"
SpeedDown.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
SpeedDown.BorderColor3 = Color3.fromRGB(255, 0, 0)

SpeedLabel.Parent = MainFrame
SpeedLabel.Position = UDim2.new(0, 0, 0.6, 0)
SpeedLabel.Size = UDim2.new(1, 0, 0.15, 0)
SpeedLabel.Text = "Speed: " .. speed
SpeedLabel.BackgroundTransparency = 1

-- Tombol Minimize (-)
MinBtn.Parent = MainFrame
MinBtn.Position = UDim2.new(0.7, 0, 0, 0)
MinBtn.Size = UDim2.new(0, 20, 0, 30)
MinBtn.Text = "-"
MinBtn.BackgroundTransparency = 1
MinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

-- Tombol Hapus (X)
CloseBtn.Parent = MainFrame
CloseBtn.Position = UDim2.new(0.85, 0, 0, 0)
CloseBtn.Size = UDim2.new(0, 20, 0, 30)
CloseBtn.Text = "X"
CloseBtn.BackgroundTransparency = 1
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

-- LOGIC MINIMIZE
local minimized = false
MinBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	if minimized then
		MainFrame:TweenSize(UDim2.new(0, 150, 0, 30), "Out", "Quad", 0.3, true)
		MinBtn.Text = "+"
		FlyBtn.Visible = false
		SpeedUp.Visible = false
		SpeedDown.Visible = false
		SpeedLabel.Visible = false
	else
		MainFrame:TweenSize(UDim2.new(0, 150, 0, 200), "Out", "Quad", 0.3, true)
		MinBtn.Text = "-"
		FlyBtn.Visible = true
		SpeedUp.Visible = true
		SpeedDown.Visible = true
		SpeedLabel.Visible = true
	end
end)

-- LOGIC SPEED
SpeedUp.MouseButton1Click:Connect(function()
	speed = speed + 10
	SpeedLabel.Text = "Speed: " .. speed
end)

SpeedDown.MouseButton1Click:Connect(function()
	speed = math.max(10, speed - 10)
	SpeedLabel.Text = "Speed: " .. speed
end)

-- LOGIC DELETE
CloseBtn.MouseButton1Click:Connect(function()
	ScreenGui:Destroy()
end)

-- LOGIC FLY (Simple Version)
FlyBtn.MouseButton1Click:Connect(function()
	flying = not flying
	FlyBtn.Text = flying and "Fly: ON" or "Fly: OFF"
	FlyBtn.BackgroundColor3 = flying and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(200, 200, 200)
	
	local char = lp.Character
	local humRoot = char:WaitForChild("HumanoidRootPart")
	
	if flying then
		local bv = Instance.new("BodyVelocity", humRoot)
		bv.Velocity = Vector3.new(0, 0, 0)
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Name = "MINT_FLY"
		
		task.spawn(function()
			while flying do
				bv.Velocity = char.Humanoid.MoveDirection * speed
				task.wait()
			end
			bv:Destroy()
		end)
	end
end)
